# MTAR Railway environment variables
# Set secrets in Railway Variables. Do not commit real secret values.

# NiceGUI
MTAR_RELOAD=0

# Persistent storage
# If a Railway Volume is mounted, MTAR auto-detects RAILWAY_VOLUME_MOUNT_PATH.
# Optional manual overrides:
# MTAR_DB_PATH=/data/mtar_jobs.sqlite3
# MTAR_DOCUMENT_ROOT=/data/mtar_data

# Gmail intake
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_ID=me
GMAIL_POLL_SECONDS=300

# Optional COC template path if bundled into the deployment
# MTAR_COC_TEMPLATE=assets/BLANK_COC.pdf
